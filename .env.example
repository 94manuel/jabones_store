# Infraestructura
POSTGRES_USER=jabones
POSTGRES_PASSWORD=jabones_seguro_cambiar
POSTGRES_DB=jabones_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jabones:jabones_seguro_cambiar@postgres:5432/jabones_db

# Backend NestJS
PORT=4000
API_PUBLIC_PORT=4001
NODE_ENV=development
JWT_SECRET=reemplace-por-un-secreto-largo-y-seguro-de-minimo-32-caracteres
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3001
ADMIN_EMAIL=admin@cocoessencia.co
ADMIN_PASSWORD=Admin123!
SEED_DATABASE=true
DATABASE_SSL=false

# MinIO para archivos
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cocoesencia-files
MINIO_REGION=us-east-1
MINIO_AUTO_CREATE_BUCKET=true
MINIO_MAX_FILE_SIZE_MB=25
MINIO_PUBLIC_BASE_URL=http://localhost:3001/api/backend/files/public
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Pasarela Wompi (sandbox en desarrollo)
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR_LLAVE_PUBLICA
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR_SECRETO_INTEGRIDAD
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR_SECRETO_EVENTOS

# Chat n8n. Puede dejarse vacío: el API responde en modo demostración.
N8N_CHAT_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_TOKEN=

# Frontend Next.js SSR
API_INTERNAL_URL=http://api:4000/api/v1
WEB_PUBLIC_PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# n8n opcional (docker compose --profile automation up)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-clave-n8n
N8N_ENCRYPTION_KEY=cambiar-por-clave-segura-n8n
